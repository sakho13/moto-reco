{
  "plansDirectory": ".plans",
  "permissions": {
    "allow": [
      "Bash(git show:*)",
      "Bash(git checkout *)",
      "Bash(git push *)",
      "Bash(docker exec:*)",
      "Bash(docker ps:*)",
      "Bash(docker inspect:*)",
      "Bash(docker logs:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(xargs:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr edit:*)",
      "Bash(pnpm check-types:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Read(.env.local)",
      "mcp__playwright__*"
    ],
    "deny": ["Read(.env)", "Read(.env.production)"],
    "ask": ["Bash(gh issue close:*)", "Bash(curl:*)", "Bash(ssh:*)"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm format"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  }
}
