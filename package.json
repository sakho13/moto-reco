{
  "name": "motoreco",
  "private": true,
  "scripts": {
    "build": "dotenv -- turbo run build",
    "dev": "dotenv -e .env.local -- turbo run dev",
    "dev:web": "dotenv -e .env.local -- pnpm --filter web dev",
    "dev:docs": "pnpm --filter docs dev",
    "dev:mobile": "dotenv -e .env.local -- pnpm --filter mobile dev",
    "dev:api": "dotenv -e .env.local -- pnpm --filter api dev",
    "test": "dotenv -e .env.local -- turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx,md}\" \"packages/**/*.{ts,tsx,md}\" \"*.md\" --ignore-path .prettierignore",
    "check-types": "turbo run check-types",
    "storybook": "turbo run storybook"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.4",
    "dotenv": "catalog:",
    "dotenv-cli": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "4.2.4",
    "turbo": "2.9.9",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18"
  }
}
